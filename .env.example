# 手元の開発の設定。cp .env.example .env でコピーして使う（.env はリポジトリに入れない）。
# docker-compose とバックエンド（application.yml の spring.config.import）の両方が読む。
# 書かなければ、同じ値が既定値として使われる
POSTGRES_DB=fitlog
POSTGRES_USER=fitlog
POSTGRES_PASSWORD=fitlog
POSTGRES_PORT=5432

# JWT の署名の鍵（32バイト以上）。openssl rand -base64 48 の結果を入れる。空だとバックエンドが起動しない
JWT_SECRET=
